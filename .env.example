# Required for local runs: used for every LLM call. Create the key in the
# Claude Console (https://platform.claude.com/), ideally one named "jobradar"
# with a monthly spend limit, so its usage shows up on its own.
#
# The GitHub Actions workflows don't read this file. There, either add the
# same key as the repo secret ANTHROPIC_API_KEY (simplest), or set up workload
# identity federation so no key is stored at all (docs/CLOUD.md). To avoid
# keeping a key on disk locally too, run `ant auth login` and leave this line
# out: a set ANTHROPIC_API_KEY always wins over an `ant` profile, even when
# it's empty.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: override the default model tiers
JOBRADAR_SCORING_MODEL=claude-haiku-4-5
JOBRADAR_WRITEUP_MODEL=claude-sonnet-4-6

# Optional: model tiers for the application-tailoring pipeline (jobradar.apply).
# Writer drafts the tailored CV + cover letter; helper does JD extraction and
# fresh scoring.
# JOBRADAR_APPLY_WRITER_MODEL=claude-sonnet-4-6
# JOBRADAR_APPLY_HELPER_MODEL=claude-haiku-4-5

# Optional: web_search discovery model. Defaults to claude-haiku-4-5 — cheaper
# (~$0.10-0.33/run) AND, in practice, the more reliable tier here (finishes in
# ~1-2 min vs Sonnet+dynamic-filtering's 13-15 min / timeouts). Set to
# claude-sonnet-4-6 to trade reliability for higher recall once its latency is
# sorted.
# JOBRADAR_WEB_SEARCH_MODEL=claude-haiku-4-5
# Optional: cap searches per run (default 5) and the call timeout in seconds
# (default 900 — generous enough for Sonnet; Haiku finishes well under it. A
# stuck call fails at the timeout and the run falls back to company_pages).
# JOBRADAR_WEB_SEARCH_MAX_USES=5
# JOBRADAR_WEB_SEARCH_TIMEOUT=900

# Optional: how many postings the scoring stage scores in parallel (default 8).
# Scoring is one Haiku call per posting and is the largest term in a run's wall
# clock, so the calls are fanned out; the ceiling is your account's rate limit,
# not the machine. Lower it if the run log shows 429 retries, raise it if you
# have headroom and want a faster run. 1 restores the old sequential behaviour.
# JOBRADAR_SCORING_WORKERS=8

# Optional: the writing section of your portfolio site, crawled by
# `python -m jobradar.evidence` into profile/evidence/. Set it and the --site
# argument can be dropped. Only pages tagged og:type=article are ingested.
# JOBRADAR_EVIDENCE_SITE=https://you.github.io/notes/

# Optional: model tier for the interview-prep sheet (jobradar.apply --prep).
# JOBRADAR_APPLY_PREP_MODEL=claude-sonnet-4-6

# Optional: progress reporting for jobradar.apply. Each posting costs a page
# fetch and three to five model calls, and drafting a CV plus a German cover
# letter is minutes of one call, so every step announces itself and shows a
# live counter of the text streaming back. Set JOBRADAR_PROGRESS=0 for plain
# log lines only. When the output is not a terminal (CI, tee, cron mail) the
# live line becomes a "still running" heartbeat every N seconds instead.
# JOBRADAR_PROGRESS=1
# JOBRADAR_PROGRESS_INTERVAL=20
# Optional: restore httpx's per-call "HTTP Request: ... 200 OK" line, demoted
# to keep the progress timeline readable. For debugging the transport itself.
# JOBRADAR_LOG_HTTP=1

# --- Email notification (jobradar.notify; set as CI secrets in production) ---
# Required to send the daily headline email:
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_app_password   # Gmail: an App Password, not your login
# Optional:
# EMAIL_TO=you@gmail.com        # defaults to SMTP_USER (email yourself)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# EMAIL_FROM=you@gmail.com
# JOBRADAR_NOTIFY_ALWAYS=1      # email every run, not just signal days
